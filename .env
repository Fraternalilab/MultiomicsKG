# Point to a root folder where to store the runtime files from Neo4J, OpenWeb UI, source databases and output files of MultiomicsKG.
DATASTORE="/path/to/your/datastore"
# Your own OpenAI and Anthropic API keys.
# You can get your OpenAI API key from https://platform.openai.com/account/api-keys and your Anthropic API key from https://console.anthropic.com/account/api-keys.
# Note: if you don't have an Anthropic/OpenAI API key, you can leave these variables empty. In this case, the GraphRAG Chatbot will not work, but the MCP Server will.
OPENAI_API_KEY="sk-proj-XXXXXXXXXXXXXXXXXXXXXXXX"
ANTHROPIC_API_KEY="sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX"

# Change the values of the following variables only if necessary. The default values are set to work with the Docker Compose configurations provided in this repository.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="multiomicskg"
NEO4J_DATABASE="neo4j"
NEO4J_DATA="$DATASTORE/neo4j/data"
NEO4J_PLUGINS="$DATASTORE/neo4j/plugins"
NEO4J_LOGS="$DATASTORE/neo4j/logs"
NEO4J_BASIC_AUTH=$(echo -n "$NEO4J_USERNAME:$NEO4J_PASSWORD" | base64)
NEO4J_AUTH="$NEO4J_USERNAME/$NEO4J_PASSWORD"
OPEN_WEBUI="$DATASTORE/open-webui"
OPENAI_MODEL="gpt-4o-mini"
OLLAMA_MODEL="gemma3:27b"
OLLAMA_EMBEDDING_MODEL="mxbai-embed-large"
ANTHROPIC_MODEL="claude-opus-5-5"
OLLAMA_HOST_FOR_DOCKER="http://host.docker.internal:11434"
OLLAMA_BASE_URL_FOR_DOCKER="http://host.docker.internal:11434"
TOKENIZERS_PARALLELISM="true"
OLLAMA_CONTEXT_LENGTH=8192
